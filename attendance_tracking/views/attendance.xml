<odoo>
  <record id="action_attendance_create" model="ir.actions.act_window">
    <field name="name">Time In</field>
    <field name="res_model">attendance_tracking.attendance</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
  </record>

  <record id="view_attendance_tree" model="ir.ui.view">
    <field name="name">attendance.tree</field>
    <field name="model">attendance_tracking.attendance</field>
    <field name="arch" type="xml">
      <list string="Attendance Records" create="false" edit="false">
        <header>
          <button type="object" name="action_time_in" string="Time In" icon="fa-clock-o"
            display="always" class="btn btn-primary" />
          <button type="object" name="action_time_out" string="Time Out" icon="fa-clock-o"
            display="always" class="btn btn-danger" />
        </header>
        <field name="date" />
        <field name="student_id" />
        <field name="time_in" />
        <field name="time_out" />
        <field name="status" widget="badge"
          decoration-success="status == 'complete'"
          decoration-warning="status == 'in_progress'" />
      </list>
    </field>
  </record>

  <record id="view_attendance_form" model="ir.ui.view">
    <field name="name">attendance.form</field>
    <field name="model">attendance_tracking.attendance</field>
    <field name="arch" type="xml">
      <form string="Attendance Record">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button
              type="object"
              name="action_time_out"
              class="oe_stat_button"
              icon="fa-clock-o"
              invisible="not id or status != 'in_progress'">
              <div class="o_stat_info">
                <span class="o_stat_text">Time Out</span>
              </div>
            </button>
          </div>
          <group>
            <field name="student_id" readonly="1" />
            <field name="date" readonly="1" />
            <field name="status" widget="badge" readonly="1"
              decoration-success="status == 'complete'"
              decoration-warning="status == 'in_progress'" />
            <field name="time_in" readonly="1" />
            <field name="time_out" readonly="1" invisible="status != 'complete'" />
          </group>
          <group string="Photos">
            <group>
              <field name="time_in_image" widget="webcam" string="Time In Photo" />
            </group>
            <group>
              <field name="time_out_image" widget="webcam" string="Time Out Photo"
                invisible="not id" />
            </group>
          </group>
          <group string="Video">
            <group>
              <field name="video" widget="videoWidget" string="Link" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_attendance" model="ir.actions.act_window">
    <field name="name">Attendance Record</field>
    <field name="res_model">attendance_tracking.attendance</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_attendance_tree" />
  </record>

  <menuitem id="menu_attendance" name="Attendance" parent="menu_attendance_root"
    action="action_attendance" />
</odoo>