<odoo>
  <!-- Department -->
  <record id="view_department_tree" model="ir.ui.view">
    <field name="name">department.tree</field>
    <field name="model">attendance_tracking.department</field>
    <field name="arch" type="xml">
      <list string="Departments">
        <field name="title" />
      </list>
    </field>
  </record>

  <record id="view_department_form" model="ir.ui.view">
    <field name="name">department.form</field>
    <field name="model">attendance_tracking.department</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <h1>
            <field name="title" string="Department Name" />
          </h1>
          <notebook>
            <page string="Students">
              <field name="student_id">
                <list string="Students">
                  <field name="name" />
                  <field name="email" />
                  <field name="position_id" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_department" model="ir.actions.act_window">
    <field name="name">Departments</field>
    <field name="res_model">attendance_tracking.department</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_department_tree" />
  </record>

  <!-- Position -->
  <record id="view_position_tree" model="ir.ui.view">
    <field name="name">position.tree</field>
    <field name="model">attendance_tracking.position</field>
    <field name="arch" type="xml">
      <list string="Positions">
        <field name="title" />
      </list>
    </field>
  </record>

  <record id="view_position_form" model="ir.ui.view">
    <field name="name">position.form</field>
    <field name="model">attendance_tracking.position</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <h1>
            <field name="title" string="Position Title" />
          </h1>
          <notebook>
            <page string="Students">
              <field name="student_id">
                <list string="Students">
                  <field name="name" />
                  <field name="email" />
                  <field name="department_id" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_position" model="ir.actions.act_window">
    <field name="name">Positions</field>
    <field name="res_model">attendance_tracking.position</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_position_tree" />
  </record>

  <!-- Configuration menu -->
  <menuitem id="menu_configuration" name="Configuration" parent="menu_attendance_root"
    sequence="100" />
  <menuitem id="menu_department" name="Department" parent="menu_configuration"
    action="action_department" />
  <menuitem id="menu_position" name="Position" parent="menu_configuration" action="action_position" />
</odoo>