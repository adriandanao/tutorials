<templates>
  <t t-name="inventory.Dashboard">
    <div class="o_dashboard p-4 pb-5"
      style="background-color: #1e1e2e; color: #cdd6f4;">

      <h1 class="mb-4 fw-bold"
        style="color: #cdd6f4; border-bottom: 1px solid #313244; padding-bottom: 0.75rem;">
        Inventory Dashboard
      </h1>

      <!-- Stats row -->
      <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
          <div class="card h-100 border-0 p-3 text-center" style="background-color: #313244;">
            <div class="mb-1"
              style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: #a6adc8;">Total
              Products</div>
            <div class="fw-bold" style="font-size: 2rem; color: #89b4fa;"
              t-esc="state.stats.total_products" />
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="card h-100 border-0 p-3 text-center" style="background-color: #313244;">
            <div class="mb-1"
              style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: #a6adc8;">Stock
              Value</div>
            <div class="fw-bold" style="font-size: 2rem; color: #a6e3a1;"
              t-esc="'$' + (state.stats.total_stock_value || 0).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})" />
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="card h-100 border-0 p-3 text-center" style="background-color: #313244;">
            <div class="mb-1"
              style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: #a6adc8;">Low
              Stock</div>
            <div class="fw-bold" style="font-size: 2rem; color: #f9e2af;"
              t-esc="state.stats.total_low_stock" />
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="card h-100 border-0 p-3 text-center" style="background-color: #313244;">
            <div class="mb-1"
              style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: #a6adc8;">Out
              of Stock</div>
            <div class="fw-bold" style="font-size: 2rem; color: #f38ba8;"
              t-esc="state.stats.total_out_of_stock" />
          </div>
        </div>
      </div>

      <!-- Charts row -->
      <div class="row g-3 mb-4">

        <!-- Chart -->
        <div class="col-lg-6">
          <div class="rounded p-3 h-100" style="background-color: #181825;">
            <h5 class="mb-3 fw-semibold" style="color: #cdd6f4;">&#128200; Adjustments: Incoming
              vs.
              Outgoing per Month</h5>
            <canvas t-ref="adjustmentsChart" style="max-height: 300px;" />
          </div>
        </div>

        <!-- Low Stock Table -->
        <div class="col-lg-3">
          <div class="rounded p-3 h-100" style="background-color: #181825;">
            <h5 class="mb-3 fw-semibold" style="color: #f9e2af;">&#9888; Low Stock</h5>
            <div class="table-responsive">
              <table class="table table-sm mb-0" style="color: #cdd6f4; border-color: #313244;">
                <thead
                  style="background-color: #11111b; color: #a6adc8; font-size: 0.8rem; text-transform: uppercase;">
                  <tr>
                    <th>Product</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Min</th>
                    <th class="text-end">Price</th>
                  </tr>
                </thead>
                <tbody>
                  <tr t-foreach="state.lowStock" t-as="p" t-key="p.id"
                    t-on-click="() => openRecord('inventory.products', p.id)"
                    style="border-color: #313244; cursor: pointer;">
                    <td t-esc="p.product_name" />
                    <td class="text-end fw-semibold" style="color: #f9e2af;"
                      t-esc="p.stock.toLocaleString('en-US')" />
                    <td class="text-end" t-esc="p.min_stock.toLocaleString('en-US')" />
                    <td class="text-end"
                      t-esc="'$' + p.price.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})" />
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Out of Stock Table -->
        <div class="col-lg-3">
          <div class="rounded p-3 h-100" style="background-color: #181825;">
            <h5 class="mb-3 fw-semibold" style="color: #f38ba8;">&#10005; Out of Stock</h5>
            <div class="table-responsive">
              <table class="table table-sm mb-0" style="color: #cdd6f4; border-color: #313244;">
                <thead
                  style="background-color: #11111b; color: #a6adc8; font-size: 0.8rem; text-transform: uppercase;">
                  <tr>
                    <th>Product</th>
                    <th class="text-end">Min Stock</th>
                    <th class="text-end">Price</th>
                  </tr>
                </thead>
                <tbody>
                  <tr t-foreach="state.outOfStock" t-as="p" t-key="p.id"
                    t-on-click="() => openRecord('inventory.products', p.id)"
                    style="border-color: #313244; cursor: pointer;">
                    <td t-esc="p.product_name" />
                    <td class="text-end" t-esc="p.min_stock.toLocaleString('en-US')" />
                    <td class="text-end"
                      t-esc="'$' + p.price.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})" />
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>

      <div class="row g-3 mb-4">
        <!-- Recent Adjustments -->
        <div class="col-md-6">
          <div class="rounded p-3 mb-1" style="background-color: #181825;">
            <h5 class="mb-3 fw-semibold" style="color: #cdd6f4;">&#128336; Recent Adjustments</h5>
            <div class="table-responsive">
              <table class="table table-sm mb-0" style="color: #cdd6f4; border-color: #313244;">
                <thead
                  style="background-color: #11111b; color: #a6adc8; font-size: 0.8rem; text-transform: uppercase;">
                  <tr>
                    <th>Date</th>
                    <th>Product</th>
                    <th>Type</th>
                    <th class="text-end">Units</th>
                    <th>Reason</th>
                  </tr>
                </thead>
                <tbody>
                  <tr t-foreach="state.recentAdjustments" t-as="a" t-key="a.id"
                    t-on-click="() => openRecord('inventory.adjustments', a.id)"
                    style="border-color: #313244; cursor: pointer;">
                    <td style="color: #a6adc8; font-size: 0.85rem;" t-esc="formatDate(a.date)" />
                    <td class="fw-medium" t-esc="a.product_id[1]" />
                    <td>
                      <span
                        t-att-class="'badge ' + (a.type === 'incoming' ? 'bg-success' : 'bg-danger')"
                        t-esc="a.type" />
                    </td>
                    <td class="text-end fw-semibold"
                      t-att-style="'color: ' + (a.type === 'incoming' ? '#a6e3a1' : '#f38ba8') + ';'"
                      t-esc="(a.type === 'incoming' ? '+' : '-') + a.units.toLocaleString('en-US')" />
                    <td style="color: #a6adc8;" t-esc="a.reason || ''" />
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <!-- Top Selling Products -->
        <div class="col-md-6">
          <div class="rounded p-3 h-100" style="background-color: #181825;">
            <h5 class="mb-3 fw-semibold" style="color: #89b4fa;">&#9650; Top Selling Products</h5>
            <div class="table-responsive">
              <table class="table table-sm mb-0" style="color: #cdd6f4; border-color: #313244;">
                <thead
                  style="background-color: #11111b; color: #a6adc8; font-size: 0.8rem; text-transform: uppercase;">
                  <tr>
                    <th>Product</th>
                    <th class="text-end">Units Sold</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Revenue</th>
                  </tr>
                </thead>
                <tbody>
                  <tr t-foreach="state.topSelling" t-as="p" t-key="p.id"
                    t-on-click="() => openRecord('inventory.products', p.id)"
                    style="border-color: #313244; cursor: pointer;">
                    <td class="fw-medium" t-esc="p.product_name" />
                    <td class="text-end" t-esc="p.total_sold.toLocaleString('en-US')" />
                    <td class="text-end" t-esc="p.stock.toLocaleString('en-US')" />
                    <td class="text-end"
                      t-esc="'$' + p.price.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})" />
                    <td class="text-end fw-semibold" style="color: #a6e3a1;"
                      t-esc="'$' + p.total_revenue.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})" />
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    </div>
  </t>
</templates>