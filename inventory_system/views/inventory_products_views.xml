<odoo>
  <record id="view_inventory_products_tree" model="ir.ui.view">
    <field name="name">inventory.products.tree</field>
    <field name="model">inventory.products</field>
    <field name="arch" type="xml">
      <list string="Products" class="text-center">
        <field name="product_name" string="Product" />
        <field name="sku_number" string="SKU" />
        <field name="category_id" string="Category" />
        <field name="stock" />
        <field name="price" />
        <field name="status" widget="badge"
          decoration-success=" status== 'in_stock'"
          decoration-warning="status == 'low_stock'"
          decoration-danger="status == 'out_of_stock'" />
        <field name="last_restocked" />
      </list>
    </field>
  </record>

  <record id="view_inventory_products_form" model="ir.ui.view">
    <field name="name">inventory.products.form</field>
    <field name="model">inventory.products</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="status" widget="statusbar"
            statusbar_colors="{'in_stock': 'green', 'low_stock': 'yellow', 'out_of_stock': 'red'}" />
        </header>
        <sheet>
          <div>
            <h1>
              <field name="product_name" string="Product Name" />
            </h1>
          </div>
          <field name="category_id" />
          <group>
            <field name="sku_number" string="SKU Number" />
            <field name="stock" />
            <field name="price" />
          </group>
          <notebook>
            <page string="Product Details">
              <group>
                <field name="description" string="Description" />
                <field name="min_stock" string="Mininum Stock" />
                <field name="last_restocked" string="Last Restock" readonly="1" />
              </group>
            </page>
            <page string="Suppliers">
              <group>
                <field name="supplier" />
                <field name="location" />
              </group>
            </page>
            <page string="Stock Adjustments">
              <field name="adjustment_ids">
                <list string="Stock Adjustments" decoration-danger="type == 'outgoing'"
                  decoration-success="type == 'incoming'" default_order="date desc" editable="top"
                  limit="5">
                  <field name="type" />
                  <field name="reason" />
                  <field name="units" />
                  <field name="date" readonly="1" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_inventory_products" model="ir.actions.act_window">
    <field name="name">Products</field>
    <field name="res_model">inventory.products</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_inventory_products_tree" />
  </record>

  <!-- Search View -->
  <record id="inventory_products_search" model="ir.ui.view">
    <field name="name">inventory.products.search</field>
    <field name="model">inventory.products</field>
    <field name="arch" type="xml">
      <search string="Search Products">
        <field name="product_name" />
        <field name="sku_number" />
        <field name="stock" filter_domain="[('stock', '>=', self)]" />
        <field name="price" filter_domain="[('price', '>=', self)]" />

        <separator />
        <filter string="Group by Category" name="category_group"
          context="{'group_by': 'category_id'}" />
        <filter string="Group by Status" name="status_group"
          context="{'group_by': 'status'}" />
      </search>
    </field>
  </record>

  <menuitem id="menu_inventory_stock" name="Stock" parent="menu_inventory_root" sequence="3" />

  <menuitem id="menu_inventory_products" name="Products" parent="menu_inventory_stock"
    action="action_inventory_products" />
</odoo>