<odoo>
  <record id="view_inventory_adjustments" model="ir.ui.view">
    <field name="name">inventory.adjustments.form</field>
    <field name="model">inventory.adjustments</field>
    <field name="arch" type="xml">
      <list string="Inventory Adjustments" decoration-danger="type == 'outgoing'"
        decoration-success="type == 'incoming'" default_order="date desc" editable="top" limit="10">
        <field name="date" readonly="1" />
        <field name="product_id" />
        <field name="type" />
        <field name="units" />
        <field name="reason" />
      </list>
    </field>
  </record>

  <record id="view_inventory_adjustments_graph" model="ir.ui.view">
    <field name="name">inventory.adjustments.graph</field>
    <field name="model">inventory.adjustments</field>
    <field name="arch" type="xml">
      <graph string="Adjustments per Month" type="bar">
        <field name="date" interval="month" type="row" />
        <field name="type" type="col" />
        <field name="units" type="measure" />
      </graph>
    </field>
  </record>

  <record id="view_inventory_adjustments_graph_by_product" model="ir.ui.view">
    <field name="name">inventory.adjustments.graph.by.product</field>
    <field name="model">inventory.adjustments</field>
    <field name="arch" type="xml">
      <graph string="Adjustments by Product" type="bar">
        <field name="product_id" type="row" />
        <field name="type" type="col" />
        <field name="units" type="measure" />
      </graph>
    </field>
  </record>

  <record id="action_inventory_adjustments" model="ir.actions.act_window">
    <field name="name">Inventory Adjustments</field>
    <field name="res_model">inventory.adjustments</field>
    <field name="view_mode">list,graph</field>
    <field name="view_id" ref="view_inventory_adjustments" />
  </record>

  <menuitem id="menu_inventory_adjustments" name="Adjustments" parent="menu_inventory_stock"
    action="action_inventory_adjustments" sequence="1" />
</odoo>