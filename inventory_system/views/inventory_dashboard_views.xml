<odoo>
  <!-- Low Stock Products List View -->
  <record id="view_inventory_products_low_stock_list" model="ir.ui.view">
    <field name="name">inventory.products.low.stock.list</field>
    <field name="model">inventory.products</field>
    <field name="arch" type="xml">
      <list string="Low Stock Products">
        <field name="product_name" />
        <field name="stock" />
        <field name="min_stock" />
        <field name="price" widget="monetary" />
      </list>
    </field>
  </record>

  <!-- Action for Low Stock Products (must be defined before the dashboard form view) -->
  <record id="action_low_stock_products" model="ir.actions.act_window">
    <field name="name">Low Stock Products</field>
    <field name="res_model">inventory.products</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="view_inventory_products_low_stock_list" />
    <field name="domain">[("stock", "&gt;", 0), ("stock", "&lt;=", "min_stock")]</field>
  </record>

  <!-- Dashboard Form View -->
  <record id="view_inventory_dashboard_form" model="ir.ui.view">
    <field name="name">inventory.dashboard.form</field>
    <field name="model">inventory.dashboard</field>
    <field name="arch" type="xml">
      <form string="Inventory Dashboard" create="false" edit="false">
        <sheet>
          <div class="oe_title">
            <h1>Inventory Dashboard</h1>
          </div>
          <group>
            <group string="Statistics">
              <group>
                <field name="total_products" readonly="1" class="text-center fw-bold" />
                <field name="total_stock_value" readonly="1" class="text-center fw-bold" />
              </group>
              <group>
                <field name="total_low_stock" readonly="1" class="text-center fw-bold" />
                <field name="total_out_of_stock" readonly="1" class="text-center fw-bold" />
              </group>
            </group>
            <group string="Top Selling Products">
              <field name="top_selling_product_ids" readonly="1" nolabel="1">
                <list create="false" edit="false" delete="false" limit="5">
                  <field name="product_name" string="Product" />
                  <field name="total_sold" />
                  <field name="stock" />
                  <field name="price" widget="monetary" />
                  <field name="total_revenue" widget="monetary" />
                </list>
              </field>
            </group>
          </group>
          <notebook>
            <page string="Low Stock Items">
              <field name="low_stock_product_ids" readonly="1" nolabel="1">
                <list create="false" edit="false" delete="false">
                  <field name="product_name" />
                  <field name="stock" />
                  <field name="min_stock" />
                  <field name="price" widget="monetary" />
                </list>
              </field>
            </page>
            <page string="Out of Stock Items">
              <field name="out_of_stock_product_ids" readonly="1" nolabel="1">
                <list create="false" edit="false" delete="false">
                  <field name="product_name" />
                  <field name="stock" />
                  <field name="min_stock" />
                  <field name="price" widget="monetary" />
                </list>

              </field>
            </page>
            <page string="Recent Adjustments">
              <field name="recent_adjustment_ids" readonly="1" nolabel="1">
                <list create="false" edit="false" delete="false"
                  decoration-success="type == 'incoming'" decoration-danger="type == 'outgoing'">
                  <field name="date" />
                  <field name="product_id" />
                  <field name="type" />
                  <field name="units" />
                  <field name="reason" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Dashboard Action -->
  <record id="action_inventory_dashboard" model="ir.actions.act_window">
    <field name="name">Dashboard</field>
    <field name="res_model">inventory.dashboard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_inventory_dashboard_form" />
    <field name="target">current</field>
  </record>

  <!-- Root Menu -->
  <menuitem id="menu_inventory_root"
    name="Inventory System"
    sequence="1" />

  <!-- Dashboard Menu -->
  <menuitem id="menu_inventory_dashboard"
    name="Dashboard"
    parent="menu_inventory_root"
    action="action_inventory_dashboard"
    sequence="1" />
</odoo>