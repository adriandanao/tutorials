<odoo>
  <!-- Client Action Dashboard -->
  <record id="action_my_dashboard" model="ir.actions.client">
    <field name="name">My Dashboard</field>
    <field name="tag">inventory.Dashboard</field>
  </record>

  <!-- Root Menu -->
  <menuitem id="menu_inventory_root"
    name="Inventory System"
    sequence="1" />

  <!-- Dashboard Menu -->
  <menuitem id="menu_inventory_dashboard"
    name="Dashboard"
    parent="menu_inventory_root"
    action="action_my_dashboard"
    sequence="1" />
</odoo>